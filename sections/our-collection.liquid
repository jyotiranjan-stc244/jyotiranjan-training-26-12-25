{{ 'our-collection.css' | asset_url | stylesheet_tag }}

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"
>

<section class="our-collection color-{{ section.settings.color_scheme }}">
  <div class="">

    {% if section.settings.heading != blank %}
      <h2 class="our-collection__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="carousel">
      <div class="swiper our-collection-swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              <div class="single">
                {{ block.settings.image | image_url: width: 800 | image_tag }}
                <div class="our-collection__overlay">
                  {{ block.settings.title }}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>


<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js" defer></script>
<script src="{{ 'our-collection.js' | asset_url }}" defer></script>



{% schema %}
{
  "name": "Our Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP OUR COLLECTION"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides per view",
      "min": 3,
      "max": 7,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "min": 2000,
      "max": 6000,
      "step": 500,
      "default": 3000
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Overlay text",
          "default": "Sun Protection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Collection",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
