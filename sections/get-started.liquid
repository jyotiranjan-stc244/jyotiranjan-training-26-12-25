
{{ "get-started.css" | asset_url | stylesheet_tag }}
<section class="get-started-section color-{{ section.settings.color_scheme }}">
  <div class="get-started-container">
    {% if section.settings.heading != blank %}
      <h2 class="get-started-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="get-started-grid">
      {% for block in section.blocks %}
        <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="category-image">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}

          {% if block.settings.title %}
            <p class="category-title">{{ block.settings.title }}</p>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get Started"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme_1"
    }
  ],
  "blocks": [
    {
      "type": "category-card",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "get-started",
      "category": "custom"
    }
  ]
}
{% endschema %}
