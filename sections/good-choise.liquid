{{ 'good-choice.css' | asset_url | stylesheet_tag }}

<section class="good-choice-section color-{{ section.settings.color_scheme }}">
  <div class="good-choice-container">
    {% if section.settings.title != blank %}
      <h2 class="title">{{ section.settings.title }}</h2>
    {% endif %}

    <div class="good-choice-grid">
      {% for block in section.blocks %}
        <div class="choice-card">
          {% if block.settings.image %}
            <div class="good-choice-image">
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            </div>
          {% endif %}

          {% if block.settings.title %}
            <p class="good-choice-title">{{ block.settings.title }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Make a good choice."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "sheme_1"
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "good-choice",
      "name": "good choise",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category name"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP"
    }
  ]
}
{% endschema %}
