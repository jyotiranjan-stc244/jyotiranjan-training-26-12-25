{{ 'our-story.css' | asset_url | stylesheet_tag }}

<script src="{{ 'our-story.js' | asset_url }}" defer></script>

{% assign sid = section.id %}

<section class="our-story" id="our-story-{{ sid }}">
  <div class="our-story__container">
    <!-- LEFT MEDIA (SHOPIFY VIDEO) -->
    <div class="our-story__media">
      {% if section.settings.video != blank %}
        {{
          section.settings.video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.muted,
            controls: section.settings.controls,
            playsinline: true,
            class: 'our-story__video'
        }}
      {% elsif section.settings.fallback_image != blank %}
        {{ section.settings.fallback_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
      {% endif %}
    </div>

    <!-- RIGHT CONTENT -->
    <div class="our-story__content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="our-story__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="our-story__button">
          {{ section.settings.button_label }} →
        </a>
      {% endif %}

      <!-- FEATURE SWIPER -->
      {% assign feature_blocks = section.blocks | where: 'type', 'feature' %}
      {% if feature_blocks.size > 0 %}
        <div class="our-story swiper" data-slides-desktop="2.5">
          <div class="swiper-wrapper">
            {% for block in feature_blocks %}
              <div class="swiper-slide our-story__feature" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon | image_url: width: 60 | image_tag: loading: 'lazy' }}
                {% endif %}
                <h4>{{ block.settings.title }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
            {% endfor %}
          </div>

          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- BOTTOM HIGHLIGHTS -->
  {% assign highlight_blocks = section.blocks | where: 'type', 'highlight' %}
  {% if highlight_blocks.size > 0 %}
    <div class="our-story__highlights">
      {% for block in highlight_blocks %}
        <div class="our-story__highlight" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            {{ block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy' }}
          {% endif %}
          <span>{{ block.settings.text }}</span>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Main Video"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback Image"
    },
    {
      "type": "text",
      "id": "fallback_alt",
      "label": "Fallback Image Alt"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "controls",
      "label": "Show Controls",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know Our Story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "READ MORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Card",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    },
    {
      "type": "highlight",
      "name": "Bottom Highlight",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story"
    }
  ]
}
{% endschema %}
