{% stylesheet %}
  .hero-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-slide {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .hero-slide__image {
    position: absolute;
    inset: 0;
  }

  .hero-slide__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-slide__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .hero-slide__content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    padding: 2rem;
    margin: auto;
    color: #fff;
  }

  .hero-slide__heading {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .hero-slide__text {
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  .hero-slide__btn {
    display: inline-block;
    padding: 12px 28px;
    background: var(--btn-bg);
    color: var(--btn-text);
    text-decoration: none;
    border-radius: 90px;
    font-weight: 600;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: #fff;
  }
{% endstylesheet %}

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"
>

<div class="hero-slider swiper hero-slider-{{ section.id }}">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide hero-slide" {{ block.shopify_attributes }}>
        <div class="hero-slide__image">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 2000 | image_tag }}
          {% endif %}
        </div>

        {% if block.settings.show_overlay %}
          <div class="hero-slide__overlay"></div>
        {% endif %}

        <div
          class="hero-slide__content"
          style="
            --btn-bg: {{ block.settings.btn_bg }};
            --btn-text: {{ block.settings.btn_text }};
            color: {{ block.settings.text_color }};
          "
        >
          {% if block.settings.heading %}
            <h2 class="hero-slide__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.text %}
            <p class="hero-slide__text">
              {{ block.settings.text }}
            </p>
          {% endif %}

          {% if block.settings.btn_label != blank and block.settings.btn_link != blank %}
            <a
              href="{{ block.settings.btn_link }}"
              class="hero-slide__btn"
            >
              {{ block.settings.btn_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_arrows %}
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  {% endif %}

  {% if section.settings.show_dots %}
    <div class="swiper-pagination"></div>
  {% endif %}
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js" defer="defer"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
        new Swiper('.hero-slider-{{ section.id }}', {

      loop: true,
      speed: {{ section.settings.speed }},

      {% if section.settings.autoplay %}
      autoplay: {
        delay: 3000,
        disableOnInteraction: false
      },
      {% endif %}

      pagination: {
        el: '.swiper-pagination',
        clickable: true
      },

      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev'
      }
    });
  });
</script>

{% schema %}
{
  "name": "Hero Slider (Swiper)",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slide transition speed (ms)",
      "min": 300,
      "max": 3000,
      "step": 100,
      "default": 800
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Hero Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Short description text goes here."
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "CTA label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "CTA link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "btn_bg",
          "label": "Button background",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "btn_text",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show dark overlay",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero Slider (Swiper)",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}
