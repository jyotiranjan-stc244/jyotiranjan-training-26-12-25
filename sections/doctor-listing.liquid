{{ 'doctor-listing.css' | asset_url | stylesheet_tag }}

<section class="doctor-section--{{ section.id }} main-doctor-container">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="doctor-section__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% assign doctors = shop.metaobjects.doctor.values %}

    {% if doctors.size > 0 %}
      <div class="doctor-grid">
        {% for doctor in doctors limit: 4 %}
          <div class="doctor-card">
            {% if doctor.doctor_image != blank %}
              <div class="doctor-card__image">
                {{
                  doctor.doctor_image
                  | image_url: width: 800
                  | image_tag:
                    alt: doctor.doctor_name,
                    widths: '200,400,600,800,1000',
                    sizes: '(min-width: 1024px) 400px, 90vw',
                    loading: 'lazy',
                    decoding: 'async'
                }}
              </div>
            {% endif %}

            <div class="doctor-card__content">
              {% if doctor.doctor_name %}
                <h3 class="doctor-card__name">{{ doctor.doctor_name }}</h3>
              {% endif %}

              {% if doctor.designation %}
                <p class="doctor-card__designation">{{ doctor.designation }}</p>
              {% endif %}

              {% if doctor.qualification %}
                <p class="doctor-card__qualification">{{ doctor.qualification }}</p>
              {% endif %}

              {% if doctor.description %}
                <div class="doctor-card__description">
                  {{ doctor.description | metafield_tag }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% comment %} <script>
  let doctors = {{ shop.metaobjects.doctor.values | json }};
  console.log(doctors);
</script> {% endcomment %}

{% schema %}
{
  "name": "Doctor Listing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "About Doctors"
    }
  ],
  "presets": [
    {
      "name": "Doctor Listing"
    }
  ]
}
{% endschema %}
